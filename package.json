    "@fluentui/react-components": "9.74.4",
    "@fluentui/react-icons": "2.0.317",
    "@lexical/react": "0.48.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "13.0.1",
    "electron-squirrel-startup": "1.0.1",
    "lexical": "0.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  }
}
