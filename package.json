{
  "name": "content-media-terminal",
  "productName": "自媒体桌面终端",
  "version": "0.1.0",
  "description": "Windows 本地优先的自媒体桌面终端",
  "author": "PigeonYang",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "rebuild:native": "electron-rebuild --version 43.2.0 --only better-sqlite3 --force",
    "build:mcp": "webpack --config webpack.mcp.config.mjs",
    "prebuild": "npm run rebuild:native && npm run build:mcp",
    "build": "electron-forge package",
    "premake": "node scripts/prepare-squirrel.mjs",
    "make": "electron-forge make",
    "test:startup": "node scripts/startup-check.mjs",
    "test:ui-shell": "node scripts/ui-shell-check.mjs",
    "test:task-001": "node scripts/task-001-check.mjs",
    "test:task-002": "node scripts/task-002-check.mjs",
    "test:task-003": "node scripts/task-003-check.mjs"
    ,"test:task-004": "node scripts/task-004-check.mjs",
    "test:task-005": "node scripts/task-005-check.mjs"
    ,"test:task-006": "node scripts/task-006-check.mjs",
    "test:task-007": "node scripts/task-007-check.mjs"
    ,"test:task-008": "node scripts/task-008-check.mjs",
    "test:task-009": "node scripts/task-009-check.mjs",
    "test:task-010": "node scripts/task-010-check.mjs",
    "test:task-011": "node scripts/task-011-check.mjs",
    "test:task-012": "node scripts/task-012-check.mjs",
    "test:task-013": "node scripts/task-013-check.mjs",
    "test:task-014:rules": "node scripts/task-014-platform-rules-check.mjs",
    "test:task-014": "node scripts/task-014-check.mjs"
    ,"test:task-015": "node scripts/task-015-check.mjs"
    ,"test:task-016": "node scripts/task-016-check.mjs"
    ,"test:task-017": "node scripts/task-017-check.mjs"
    ,"test:task-018": "node scripts/task-018-check.mjs"
    ,"test:task-019": "node scripts/task-019-check.mjs",
    "test:biz-001": "node scripts/biz-001-check.mjs",
    "test:biz-002": "node scripts/biz-002-check.mjs",
    "test:biz-003": "node scripts/biz-003-check.mjs",
    "test:biz-004": "node scripts/biz-004-check.mjs"
